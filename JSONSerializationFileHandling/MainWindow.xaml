<Window x:Class="DataSave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataSave"
        mc:Ignorable="d"
        Title="Offer Letter Generator"
        Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F5">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Input Form -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="15"
                Padding="20"
                Margin="0,0,15,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Offer Letter Generator"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#C2185B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Employee Name"/>
                    <TextBox x:Name="txtName"
                             Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Job Position"/>
                    <TextBox x:Name="txtPosition"
                             Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Company Name"/>
                    <TextBox x:Name="txtCompany"
                             Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Annual Salary (₹)"/>
                    <TextBox x:Name="txtSalary"
                             Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Joining Date (dd-MM-yyyy)"/>
                    <TextBox x:Name="txtJoiningDate"
                             Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Work Location"/>
                    <TextBox x:Name="txtLocation"
                             Height="32" Margin="0,5,0,20"/>

                    <Button Content="Generate Offer Letter"
                            Height="42"
                            Background="#C2185B"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,0,10"
                            Click="GenerateOfferLetter_Click"/>

                    <Button Content="Clear"
                            Height="38"
                            Click="Clear_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Offer Letter Preview -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="15"
                Padding="25">

            <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Content="Print Offer Letter"
                        Height="40"
                        Width="170"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        Background="#C2185B"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Print_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtOfferLetter"
                               Text="Your offer letter will appear here..."
                               FontSize="15"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               LineHeight="26"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
